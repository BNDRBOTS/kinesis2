# Configure these in Railway Variables. Never use a VITE_ prefix for secrets.
NODE_ENV=production
PORT=3000
APP_PASSWORD=replace-with-a-long-random-password
FAL_KEY=
REPLICATE_API_TOKEN=
RUNWAYML_API_SECRET=
LUMA_API_KEY=
MEDIA_DIR=/data
# Railway sets RAILWAY_PUBLIC_DOMAIN when a public domain is generated.
# PUBLIC_BASE_URL=https://studio.example.com
# COMFYUI_MEDIA_ORIGIN=https://your-private-comfy.example.com

# Comfy Cloud v2: requires paid Cloud API subscription; inference is remote.
COMFY_CLOUD_API_KEY=

# Image Studio (Pollinations remote inference; server-only credentials)
POLLINATIONS_API_KEY=
# Optional prompt-enhancement model override
# POLLINATIONS_TEXT_MODEL=openai/gpt-4o-mini

# Existing Image Studio: FLUX.2 Klein 4B on Cloudflare Workers AI (server-only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
